{
  "redact_private_values": true,

  // Appearance
  "icon_theme": "Catppuccin Mocha",
  "theme": "Dracula",
  "ui_font_size": 17,
  "buffer_font_size": 18,
  "buffer_font_family": "Maple Mono NF",

  // Editor behavior
  "base_keymap": "VSCode",
  "vim_mode": false,
  "vim": {},
  "relative_line_numbers": true,
  "indent_guides": { "enabled": true, "coloring": "indent_aware" },
  "tabs": { "show_diagnostics": "errors" },
  "tab_bar": { "show": true },
  "scrollbar": { "show": "never" },
  "centered_layout": { "left_padding": 0.15, "right_padding": 0.15 },

  // Finder / UI sizing
  "file_finder": { "modal_max_width": "medium" },

  // AI / Assistant configuration
  "features": { "edit_prediction_provider": "zed" },
  "agent": {
    "default_model": { "provider": "copilot_chat", "model": "gpt-4o" }
  },
  "language_models": { "ollama": { "api_url": "http://localhost:11434" } },

  // Language-specific hints & LSP
  "inlay_hints": { "enabled": true },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "className", "ngClass", "styles"]
      }
    }
  },
  "languages": {
    "TypeScript": {
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": false,
        "show_other_hints": true,
        "show_type_hints": true
      }
    },
    "Python": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "ruff" } },
      "language_servers": ["pyright", "ruff"]
    }
  },

  // Terminal / commit editor
  "terminal": {
    "font_family": "Maple Mono NF",
    "env": { "EDITOR": "zed --wait" }
  },

  // File types and exclusions
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"]
  },

  // Telemetry
  "telemetry": { "diagnostics": false, "metrics": false },

  // Panels placement
  "project_panel": { "button": true, "dock": "right", "git_status": true },
  "outline_panel": { "dock": "right" },
  "collaboration_panel": { "dock": "left" },
  "notification_panel": { "dock": "left" },

  // Git panel and other small integrations
  "git_panel": { "dock": "right" }
}
